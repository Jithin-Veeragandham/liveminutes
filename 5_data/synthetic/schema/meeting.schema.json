{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liveminutes.local/schema/meeting/1.0",
  "title": "LiveMinutes canonical meeting (AMI-compatible)",
  "description": "One meeting. Shared by AMI-converted and synthetic data. Field names follow AMI NXT where possible: nxt_agent speaker letters, dialogue acts as segments, abstractive summary sections abstract/actions/decisions/problems.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "meeting_id", "series_id", "meeting_letter", "scenario_type",
               "participants", "segments", "summary", "action_items", "qa_facts", "edge_cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source": {"enum": ["ami", "synthetic"]},
    "meeting_id": {"type": "string", "pattern": "^(ES|IS|TS|SY)[0-9]{4}[a-d]$"},
    "series_id": {"type": "string", "pattern": "^(ES|IS|TS|SY)[0-9]{4}$"},
    "meeting_letter": {"enum": ["a", "b", "c", "d"]},
    "scenario_type": {"const": "scenario", "description": "AMI meetings.xml type attribute; only the scenario partition is used."},
    "stage": {"type": ["string", "null"], "description": "AMI scenario phase: kickoff, functional, conceptual, detailed."},
    "duration_sec": {"type": ["number", "null"], "minimum": 0},
    "participants": {
      "type": "array", "minItems": 2, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "role", "status"],
        "properties": {
          "label": {"enum": ["A", "B", "C", "D", "E"], "description": "AMI nxt_agent letter; ground-truth speaker."},
          "role": {"enum": ["PM", "ME", "UI", "ID"], "description": "AMI roles: Project Manager, Marketing Expert, User Interface designer, Industrial Designer."},
          "name": {"type": ["string", "null"]},
          "global_id": {"type": ["string", "null"], "description": "AMI global_name (e.g. FEE005); null for synthetic."},
          "status": {"enum": ["present", "absent"]}
        }
      }
    },
    "segments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "speaker", "start", "end", "text"],
        "properties": {
          "id": {"type": "string"},
          "speaker": {"enum": ["A", "B", "C", "D", "E"]},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "text": {"type": "string", "minLength": 1},
          "da_type": {"type": ["string", "null"], "description": "AMI da-types.xml short name (inf, sug, ass, el.inf, off, bck, ...)."}
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["abstract", "actions", "decisions", "problems"],
      "properties": {
        "abstract":  {"type": "array", "items": {"type": "string"}},
        "actions":   {"type": "array", "items": {"type": "string"}},
        "decisions": {"type": "array", "items": {"type": "string"}},
        "problems":  {"type": "array", "items": {"type": "string"}}
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "owner", "status"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "owner": {"type": ["string", "null"], "description": "Final owner's speaker label. May be absent from the meeting. null only for an unowned (vague) task or an AMI item whose owner cannot be resolved."},
          "owner_unclear": {"type": "boolean", "default": false},
          "status": {"enum": ["active", "reassigned", "dropped", "unknown"], "description": "Final status at meeting end. 'unknown' is allowed only for source=ami."},
          "previous_owners": {"type": "array", "items": {"type": "string"}},
          "history": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["segment", "event"],
              "properties": {
                "segment": {"type": "string"},
                "event": {"enum": ["proposed", "offered", "assigned", "accepted", "reassigned", "dropped", "restated"]},
                "by": {"type": ["string", "null"]},
                "owner": {"type": ["string", "null"]}
              }
            }
          },
          "evidence_segments": {"type": "array", "items": {"type": "string"}},
          "owner_source": {"type": ["string", "null"], "description": "How the owner was derived (synthetic: 'gold'; ami: 'role_mention' or null)."}
        }
      }
    },
    "qa_facts": {
      "type": "array",
      "description": "F3 gold: atomic facts a later Q&A pair can be written from. No Q&A pairs are stored.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "fact", "evidence_segments"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["decision", "unagreed_proposal", "action_item", "action_item_removed", "absence", "plan_change", "reference_to_prior_meeting", "other"]},
          "fact": {"type": "string"},
          "agreed": {"type": ["boolean", "null"]},
          "related_action_item": {"type": ["string", "null"]},
          "refers_to_meeting": {"type": ["string", "null"]},
          "evidence_segments": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "edge_cases": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenario_id", "segments"],
        "properties": {
          "scenario_id": {"type": "string"},
          "segments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "note": {"type": "string"}
        }
      }
    },
    "provenance": {"type": "object"}
  }
}
